    ∧ ((∃ t, 1 ≤ t ∧ t ≤ 40 ∧ minB [6, 10, 14, 15, 21, 35] t = 5) ∧
        (∀ t, 1 ≤ t → t ≤ 40 → minB [6, 10, 14, 15, 21, 35] t ≤ 5)) :=
  ⟨e708_prod_append, e708_superset_law, e708_composition_law, e708_refine_law,
    e708_enum_sound, e708_enum_complete, e708_window_law, e708_asc_bridge,
