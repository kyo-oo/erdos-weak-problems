cell-selection of size EXACTLY 4, as data, in exact box708 order —
chunk-decided at the 480-instance discipline (12 A-rows x 40 t per
chunk, 114 chunks, every chunk its own bounded `decide`), assembled
by an append lemma, and bridged back to THE ORIGINAL AGGREGATE
STATEMENT (`e708_g4_box_exact`, verbatim) via `e708_exact_enum_complete`.
The Python mirror hunted every witness with the coverExact DFS (the
Lean def transcribed literally) and dual-method verified each emitted
row (subset-of-window + length + ascent + gmpy2 divisibility) —
54600/54600 rows GREEN, g4_witgen_out.txt. Zero sorry. Zero admit. -/

/-- THE EXACTLY-4 ROW CHECKER: the corpus's |B| = g(n) cell as a Bool —
length EXACTLY 4, strict ascent, window residency, divisibility cover. -/
def w708OK4 (A : List Nat) (t : Nat) (B : List Nat) : Bool :=
  (decide (B.length = 4)) && (ascB B) &&
    (B.all (fun b => (decide (t < b)) && (decide (b ≤ t + maxA A)))) &&
    (decide (prod708 B % prod708 A = 0))

/-- THE ROW-CHECKER SPEC: a true row certifies the exact-4 cover in
the corpus's own terms. -/
theorem w708OK4_spec (A : List Nat) (t : Nat) (B : List Nat)
    (h : w708OK4 A t B = true) :
    B.length = 4 ∧ sub708 B (win708 t (maxA A)) ∧ prod708 A ∣ prod708 B := by
  simp only [w708OK4, Bool.and_eq_true] at h
  obtain ⟨⟨⟨h4, hasc⟩, hall⟩, hcov⟩ := h
  have hmem : ∀ b, b ∈ B → t < b ∧ b ≤ t + maxA A := by
    intro b hb
    have hrow := (List.all_eq_true.mp hall) b hb
    simp only [Bool.and_eq_true] at hrow
    exact ⟨of_decide_eq_true hrow.1, of_decide_eq_true hrow.2⟩
  exact ⟨of_decide_eq_true h4, e708_asc_bridge t (maxA A) B hasc hmem,
    Nat.dvd_of_mod_eq_zero (of_decide_eq_true hcov)⟩

/-- The bounded nth (default [] — a misaligned lookup can never pass
the row checker: the empty product 1 is never divisible by
prod(A) >= 24, so alignment failures FAIL loudly, never silently). -/
def nthD708 : List (List Nat) → Nat → List Nat
  | [], _ => []
  | B :: _, 0 => B
  | _ :: W, n + 1 => nthD708 W n

/-- THE TABLE ROW: p = (A, [B_1, ..., B_40]) — the 40 exactly-4
covers of A at t = 1..40, in order. -/
def rowOK708 (p : List Nat × List (List Nat)) : Bool :=
  (List.range 40).all (fun r => w708OK4 p.1 (r + 1) (nthD708 p.2 r))

/-- THE APPEND LEMMA (core-only, self-proven): chunk concatenation
assembles the row table. -/
theorem e708_all_append (f : List Nat × List (List Nat) → Bool)
    (l₁ l₂ : List (List Nat × List (List Nat)))
    (h₁ : l₁.all f = true) (h₂ : l₂.all f = true) :
    (l₁ ++ l₂).all f = true := by
  apply List.all_eq_true.mpr
  intro x hx
  rcases List.mem_append.mp hx with hx | hx
  · exact (List.all_eq_true.mp h₁) x hx
  · exact (List.all_eq_true.mp h₂) x hx

