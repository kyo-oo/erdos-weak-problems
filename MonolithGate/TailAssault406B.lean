/-- **THE WITNESS FIRE.**  Every exponent in [1501, 3000] owns a table
pair whose tree edge fires: one kernel decision over all 1500 bands,
each an any-scan that short-circuits at the matching pair. -/
theorem erdos406_climb_base_3000_band : (List.all (List.range 1500) (fun i =>
    List.any witnessRows3000 (fun pr =>
      pr.1 == 1501 + i &&
        GSTTailAssault406.treeBad pr.1 (2 + pr.2)))) = true := by
  decide

open GSTU2DEventTransport in
open GSTCanonicalSevenAxisBridge in
/-- **THE BASE TO THREE THOUSAND.**  Every exponent from eight through
three thousand owns its physical Happy row at a ternary coordinate at
least three: the r29-green base to 1500 composed with the 1500-witness
fire-row extension through the green tree law. -/
theorem erdos406_climb_base_3000 :
    ∀ K : Nat, 8 ≤ K → K ≤ 3000 →
      ∃ p : Nat, 3 ≤ p ∧
        HappyCell (carry4 (4^K) p) (digit3 (4^K) p) := by
  intro K hK8 hK3000
  rcases Nat.lt_or_ge K 1501 with h | h
  · exact GSTTailAssault406.erdos406_climb_base_1500 K hK8 (by omega)
  · have hany : (List.any witnessRows3000 (fun pr =>
        pr.1 == 1501 + (K - 1501) &&
          GSTTailAssault406.treeBad pr.1 (2 + pr.2))) = true :=
      (List.all_eq_true.mp erdos406_climb_base_3000_band) (K - 1501)
        (List.mem_range.2 (by omega))
    obtain ⟨pr, _hmem, hpr⟩ := List.any_eq_true.mp hany
    simp only [Bool.and_eq_true, beq_iff_eq] at hpr
    have h1 : pr.1 = K := by omega
    have hclimb :=
      GSTFourPowerHappyProvider.commonTwoGeThree_to_physical_happy_ge_three pr.1
        (GSTTailAssault406.commonTwoGeThree_of_treeBad pr.1 (2 + pr.2)
          (by omega) hpr.2)
    rw [h1] at hclimb
    exact hclimb

/-! ## SECTION 12 The sharpened verdict — the whole problem above three thousand -/

open GSTU2DEventTransport in
open GSTCanonicalSevenAxisBridge in
/-- **THE MISSION'S SHARPEST STATEMENT, SHARPENED AGAIN.**  Erdos #406's
universal verdict follows from the climb's tail above three thousand
alone: the base band is kernel-certified to 3000 (1000 HappyCell
witnesses to 1500 plus 1500 fire-row witnesses to 3000), the
composition is machine-proven, and the entire remaining mathematical
content of the problem is the single named hypothesis — now with its
automaton face exposed by SECTION 10. -/
theorem erdos406_universal_verdict_of_tail_3000
    (htail : ∀ K : Nat, 3000 < K →
      ∃ p : Nat, 3 ≤ p ∧
        HappyCell (carry4 (4^K) p) (digit3 (4^K) p)) :
    ∀ n : Nat, 9 ≤ n → noTernaryTwo (2^n) = false :=
  erdos406_universal_verdict_of_climb
    (fun K hK8 => by
      rcases Nat.lt_or_ge K 3001 with h | h
      · exact erdos406_climb_base_3000 K hK8 (by omega)
      · exact htail K (by omega))

