import MonolithGate.TailAssault406
import MonolithGate.GSTFourPowerDirectNo22

set_option maxRecDepth 1000000
set_option maxHeartbeats 20000000

/-!
# THE TAIL ASSAULT, FACE B — the automaton, the base to three thousand

THE composition BOSS ordered, round two: the r29-green tail assault
(TailAssault406, all 22 theorems sorry-free, run 45478223728) composed
with the addition-carry automaton chamber (GSTFourPowerDirectAdditionCarry)
and the no-22 engine (GSTFourPowerDirectNo22) into COMPLETE NEW THEOREMS
that expose the remaining hypothesis's AUTOMATON FACE.

The remaining content of Erdos #406 is the climb above the kernel base:
every exponent above the base owns a physical Happy row.  Face B corners
it from the machine side:

* **SECTION 8 THE TREE-AUTOMATON IDENTITY** — beyond the exponent's own
  trit length, the trit-tree fire IS the common two: the tree law and
  the climb law are one object in the deep regime.
* **SECTION 9 THE FORBIDDEN-EDGE FACE** — a counterexample to the climb
  forces every ternary digit two of `4^K` (rows at least three) off the
  two forbidden automaton states `(prev, carry) = (0,0)` and `(2,1)`
  (the addition-carry chamber's exact common-two classifier).
* **SECTION 10 THE AUTOMATON COLLISION** — the counterexample's complete
  forced structure in automaton terms: Band-I tree-survivor class AND
  all-twos-loud AND No-22 suffix AND the sharp 7/8 magnitude cap.
* **SECTION 11 THE BASE TO THREE THOUSAND** — 1500 explicit fire-row
  witnesses for [1501, 3000], each two-method verified (exact big-int
  ternary expansion and modular exponentiation) before generation;
  the kernel re-decides every one through the r29-green tree law.
* **SECTION 12 THE SHARPENED VERDICT** — the whole problem from the tail
  above three thousand alone.

The engine's terrain record (battery406t/406u/406v, two-method): every
natural in [8, 60000) fires, max row 63 at K = 47660; the natural
survivors of the immortal tree (growth ratio 2.48 per level) are
exactly the set {0, 1, 2, 3, 4, 7}.  The infinite tail beyond every
kernel horizon is the automaton dodge — SECTION 10 states its complete
face.

The engine never stops; it never lies.
-/

namespace GSTTailAssault406B

open GSTFourPowerDirectAdditionCarry
open GSTFourPowerDirectNo22

/-! ## SECTION 8 The tree-automaton identity — the deep fire is the common two -/

open GSTFourPowerDirectResidue in
/-- **THE TREE-AUTOMATON IDENTITY.**  Beyond the exponent's own trit
length (`K < 3^p`), the trit-tree's bad edge is exactly the common two
of `4^K` and `4^(K+1)` at the next row: the tree law, the digit law,
and the climb law are one object in the deep regime. -/
theorem treeBad_deep_iff_common_two (K p : Nat) (hK : K < 3^p) :
    GSTTailAssault406.treeBad K p = true ↔
      (digit3 (4^K) (p+1) = 2 ∧ digit3 (4^(K+1)) (p+1) = 2) := by
  unfold GSTTailAssault406.treeBad
  rw [Nat.mod_eq_of_lt hK]
  have hdiv : K / 3^p % 3 = 0 := by
    rw [Nat.div_eq_of_lt hK, Nat.zero_mod]
  rw [hdiv]
  simp only [Bool.and_eq_true, beq_iff_eq]
  constructor
  · rintro ⟨h1, h2⟩
    have hlt : digit3 (4^K) (p+1) < 3 := digit3_lt_three (4^K) (p+1)
    exact ⟨by omega, by omega⟩
  · rintro ⟨h1, h2⟩
    exact ⟨by omega, by omega⟩

/-! ## SECTION 9 The forbidden-edge face of the climb -/

open GSTFourPowerDirectResidue in
/-- **THE FORBIDDEN-EDGE FACE.**  A counterexample to the climb above
row three forces every ternary digit two of `4^K` off the two forbidden
automaton states: the addition-carry chamber's exact common-two
classifier, composed with the climb's negation. -/
theorem no_climb_forbids_edges (K : Nat)
    (hNo : ¬ GSTFourPowerHappyProvider.CommonTwoGeThree K) :
    ∀ p : Nat, 3 ≤ p → digit3 (4^K) p = 2 →
      ¬ ((digit3 (4^K) (p-1) = 0 ∧ binaryCarry (4^K) p = 0) ∨
         (digit3 (4^K) (p-1) = 2 ∧ binaryCarry (4^K) p = 1)) := by
  intro p hp h2 hedge
  have hcommon : digit3 (4^K) p = 2 ∧ digit3 (4*(4^K)) p = 2 :=
    (common_two_row_iff_forbidden_edges (4^K) p (by omega)).2 ⟨h2, hedge⟩
  apply hNo
  refine ⟨p, hp, hcommon.1, ?_⟩
  simpa [pow_succ, Nat.mul_comm] using hcommon.2

open GSTFourPowerDirectResidue in
/-- **THE AUTOMATON COLLISION.**  Any counterexample above the base is
simultaneously (1) a Band-I tree-survivor — its class mod 729 lies in
the level-six survivor table; (2) ALL-LOUD — every ternary digit two of
`4^K` at rows at least three rides a legal automaton state, off both
forbidden edges; (3) the owner of a No-22 ternary suffix beyond row
three; and (4) bounded by the sharp 7/8 magnitude law on every
nine-power window.  Four chambers' laws, one statement. -/
theorem tail_collision_automaton_face (K : Nat) (_hK : 1500 < K)
    (hNo : ¬ GSTFourPowerHappyProvider.CommonTwoGeThree K) :
    (GSTTailAssault406.tailS6.contains (K % 729) = true) ∧
    (∀ p : Nat, 3 ≤ p → digit3 (4^K) p = 2 →
      ¬ ((digit3 (4^K) (p-1) = 0 ∧ binaryCarry (4^K) p = 0) ∨
         (digit3 (4^K) (p-1) = 2 ∧ binaryCarry (4^K) p = 1))) ∧
    GSTFourPowerNo22Magnitude.No22Ternary (4^K / 27) ∧
    (∀ m : Nat, 4^K / 27 < 9^m → 8 * (4^K / 27) ≤ 7 * (9^m - 1)) := by
  obtain ⟨hband, hno22, hcap⟩ :=
    GSTTailAssault406.tail_counterexample_collision K (by omega) hNo
  exact ⟨hband, no_climb_forbids_edges K hNo, hno22, hcap⟩

