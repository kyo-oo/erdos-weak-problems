/-! ## The EO sweep (even + odd): for `o` odd `≤ B` in class `r` and `c` odd
    in class `r` with `o < c ≤ o + B`, if `c - o` is a census member then
    `1 < gcd (c - o) o`. -/

theorem sweepEO_0 : (TABODDB_0).all (fun o => (TABODD_0).all (fun c =>
    decide (c ≤ o) || decide (o + B < c) || (!inTAB (c - o)) ||
    decide (1 < Nat.gcd (c - o) o))) = true := by
  rfl

