/-! ## Generic helpers -/

theorem all_nil {α : Type} (p : α → Bool) : ([] : List α).all p = true := rfl

theorem allMem {α : Type} (p : α → Bool) : ∀ (l : List α), l.all p = true →
    ∀ x : α, x ∈ l → p x = true := by
  intro l
  induction l with
  | nil => intro _ x hx; cases hx
  | cons hd tl ih =>
    intro h x hx
    have hstep : (p hd && tl.all p) = true := h
    cases hx with
    | head => simp
    | tail _ hmem =>
      have hpb : p hd = true ∨ p hd = false := by cases h : p hd <;> simp [h]
      rcases hpb with hpb | hpb
      · rw [hpb] at hstep; simp at hstep; exact ih hstep x hmem
      · rw [hpb] at hstep; simp at hstep

theorem all_append {α : Type} (p : α → Bool) : ∀ l₁ l₂ : List α,
    (l₁ ++ l₂).all p = (l₁.all p && l₂.all p) := by
  intro l₁
  induction l₁ with
  | nil => intro l₂; rfl
  | cons hd tl ih =>
    intro l₂
    simp only [List.all_cons, ih]
    cases p hd <;> simp

/-! ## The table certs (decide-verified) -/

theorem tab_pos : TAB.all (fun n => decide (1 ≤ n)) = true := by decide

theorem tab_min16 : TAB.all (fun n => decide (n = 1) || decide (16 ≤ n)) = true := by decide

/-- Every even census member is `≡ 0 (mod 16)` (the `2^4` gate). -/
theorem tab_even16 : TAB.all (fun n => decide (n % 2 = 1) || decide (n % 16 = 0)) = true := by decide

theorem tab_all_inTAB : TAB.all (fun n => inTAB n) = true := by decide

theorem tabodd_0_filter : TABODD_0 = TAB.filter (fun n => decide (n % 2 = 1) && decide (n % 16 = 0)) := by decide
theorem tabodb_0_filter : TABODDB_0 = TABODDB.filter (fun n => decide (n % 16 = 0)) := by decide

theorem tabodd_1_filter : TABODD_1 = TAB.filter (fun n => decide (n % 2 = 1) && decide (n % 16 = 1)) := by decide
theorem tabodb_1_filter : TABODDB_1 = TABODDB.filter (fun n => decide (n % 16 = 1)) := by decide

