/-! ## The master theorem -/

/-- THE BOX THEOREM (table form): any two census members `a, b ≤ B` whose
    sum is again a census member satisfy `1 < gcd a b` — no pairwise-coprime
    4-powerful triple `a + b = c` with `a, b ≤ B` exists in the census. -/
theorem e939_box_census : ∀ a b : Nat, a ∈ TAB → b ∈ TAB → a ≤ B → b ≤ B →
    (a + b) ∈ TAB → 1 < Nat.gcd a b := by
  intro a b hma hmb hlea hleb hsum
  have hinTABa : inTAB a = true := allMem inTAB TAB tab_all_inTAB a hma
  have hinTABb : inTAB b = true := allMem inTAB TAB tab_all_inTAB b hmb
  have hinTABs : inTAB (a + b) = true := allMem inTAB TAB tab_all_inTAB (a + b) hsum
  have hamem : a ∈ TABODDB := (List.mem_filter.mpr ⟨hma, by
    simp only [Bool.and_eq_true, decide_eq_true]; omega⟩)
  have hbmem : b ∈ TABODDB := (List.mem_filter.mpr ⟨hmb, by
    simp only [Bool.and_eq_true, decide_eq_true]; omega⟩)
  have hcertA : a % 2 = 1 ∨ a % 16 = 0 := by
    have h := allMem (fun n => decide (n % 2 = 1) || decide (n % 16 = 0)) TAB tab_even16 a hma
    simp only [Bool.or_eq_true, decide_eq_true] at h
    exact h
  have hcertB : b % 2 = 1 ∨ b % 16 = 0 := by
    have h := allMem (fun n => decide (n % 2 = 1) || decide (n % 16 = 0)) TAB tab_even16 b hmb
    simp only [Bool.or_eq_true, decide_eq_true] at h
    exact h
  have hcertS : (a + b) % 2 = 1 ∨ (a + b) % 16 = 0 := by
    have h := allMem (fun n => decide (n % 2 = 1) || decide (n % 16 = 0)) TAB tab_even16
      (a + b) hsum
    simp only [Bool.or_eq_true, decide_eq_true] at h
    exact h
  have hamin : a = 1 ∨ 16 ≤ a := by
    have h := allMem (fun n => decide (n = 1) || decide (16 ≤ n)) TAB tab_min16 a hma
    simp only [Bool.or_eq_true, decide_eq_true] at h
    exact h
  have hbmin : b = 1 ∨ 16 ≤ b := by
    have h := allMem (fun n => decide (n = 1) || decide (16 ≤ n)) TAB tab_min16 b hmb
    simp only [Bool.or_eq_true, decide_eq_true] at h
    exact h
  have ha2 : a % 2 = 0 ∨ a % 2 = 1 := by omega
  have hb2 : b % 2 = 0 ∨ b % 2 = 1 := by omega
  rcases ha2 with hae | hao
  rcases hb2 with hbe | hbo
  · -- EE : both even, 2 divides the gcd
    have hdva : 2 ∣ a := Nat.dvd_of_mod_eq_zero (by omega)
    have hdvb : 2 ∣ b := Nat.dvd_of_mod_eq_zero (by omega)
    have hgd : 2 ∣ Nat.gcd a b := Nat.dvd_gcd hdva hdvb
    have hpos : 0 < Nat.gcd a b := Nat.gcd_pos_of_pos_left _ (by omega)
    omega
  · -- EO : a even, b odd
    have h16a : a % 16 = 0 := by
      rcases hcertA with h | h
      · omega
      · exact h
    have hage : 16 ≤ a := by
      rcases hamin with h | h
      · omega
      · exact h
    have hco : (a + b) % 2 = 1 := by omega
    have hcr : (a + b) % 16 = b % 16 := by omega
    exact eo_kill a b (a + b) rfl hsum hco hcr hbmem hinTABa hinTABs hage hlea
  · -- OE : a odd, b even (symmetric)
    have h16b : b % 16 = 0 := by
      rcases hcertB with h | h
      · omega
      · exact h
    have hbge : 16 ≤ b := by
      rcases hbmin with h | h
      · omega
      · exact h
    have hco : (b + a) % 2 = 1 := by omega
    have hcr : (b + a) % 16 = a % 16 := by omega
    have hsum' : (b + a) ∈ TAB := by rw [Nat.add_comm]; exact hsum
    have h := eo_kill b a (b + a) rfl hsum' hco hcr hamem hinTABb hinTABs hbge hleb
    rw [Nat.gcd_comm] at h
    exact h
  · -- OO : both odd
    have h16s : (a + b) % 16 = 0 := by
      rcases hcertS with h | h
      · omega
      · exact h
    rcases Nat.lt_trichotomy a b with hlt | heq | hgt
    · exact oo_kill a b (a + b) rfl hsum h16s hlt hamem hbmem hinTABs
    · -- a = b : the gcd is a itself, and a ≠ 1
      have hne : a ≠ 1 := by
        intro h1
        have h2 : 1 + 1 ∈ TAB := by rw [show 1 + 1 = a + b by omega]; exact hsum
        have h3 := allMem (fun n => decide (n = 1) || decide (16 ≤ n)) TAB tab_min16
          (1 + 1) h2
        simp only [Bool.or_eq_true, decide_eq_true] at h3
        rcases h3 with h4 | h4
        · omega
        · omega
      have hge : 16 ≤ a := by
        rcases hamin with h | h
        · exact absurd h hne
        · exact h
      rw [heq, Nat.gcd_self]
      omega
    · have hsum' : (b + a) ∈ TAB := by rw [Nat.add_comm]; exact hsum
      have h16s' : (b + a) % 16 = 0 := by rw [Nat.add_comm]; exact h16s
      have h := oo_kill b a (b + a) rfl hsum' h16s' hgt hbmem hamem hinTABs
      rw [Nat.gcd_comm] at h
      exact h

/-! ## The board -/

/-- The W66 board: the structural mod-16 obstruction (rpow form) + the box
    theorem (table form) + the Nitaj r=3 witnesses + the bracket. -/
theorem board939R5 :
