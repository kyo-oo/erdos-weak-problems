/-- The coinList filter is constantly-`7 ≤ i` (classOf_bound_all). -/
theorem fz_filter_pt (i : Nat) (hi : i < 136) :
    (decide (7 ≤ i) && decide (classOf i ≤ 127)) = decide (7 ≤ i) := by
  have hq := List.all_eq_true.mp classOf_bound_all i (List.mem_range.mpr hi)
  rw [Bool.or_eq_true] at hq
  cases hq with
  | inl hlt7 =>
      have hi7 : i < 7 := of_decide_eq_true hlt7
      have hn : ¬ (7 ≤ i) := by omega
      rw [decide_eq_false hn, Bool.false_and]
  | inr hb =>
      rw [decide_eq_true (of_decide_eq_true hb), Bool.and_true]

/-- range 136 filtered by 7 ≤ · = map (+7) (range 129). -/
theorem fz_filter_singleton_true (a : Nat) (h : decide (7 ≤ a) = true) :
    List.filter (fun i => decide (7 ≤ i)) [a] = [a] := by
  simp only [List.filter]
  rw [h]

theorem fz_range_filter_ge (N : Nat) :
    ((List.range (N + 7)).filter (fun i => decide (7 ≤ i))) = (List.range N).map (fun x => x + 7) := by
  induction N with
  | zero => rfl
  | succ N ih =>
      have hrw : N + 1 + 7 = N + 7 + 1 := by omega
      rw [hrw, List.range_succ, List.filter_append, ih, List.range_succ, List.map_append,
          List.map_cons, List.map_nil]
      rw [fz_filter_singleton_true (N + 7) (decide_eq_true (by omega))]

theorem coinList_eq : coinList = fz_UTAIL_0 := by
  unfold coinList
  rw [show (136 : Nat) = 129 + 7 from rfl,
      List.filter_congr (fun i hi => fz_filter_pt i (List.mem_range.mp hi)),
      fz_range_filter_ge 129, List.map_map]
  show List.map (fun x => (x + 7, classOf (x + 7), coinUnit (x + 7))) (List.range 129) = fz_UTAIL_0
  rw [← coinFrom_spec 129 7 5040 4 (by omega) (by omega) (by rfl) (by decide)]
  exact fz_sw_all_0

