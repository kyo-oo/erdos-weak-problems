import F22AllB

set_option exponentiation.threshold 1024
set_option maxHeartbeats 4000000
set_option maxRecDepth 262144

theorem fz_all_189 : List.all (dpRun fz_TAIL_189 fz_S_189) (fun S => decide (maxT S ≤ 253)) = true := by
  rw [fz_run_189, List.all_cons, Bool.and_eq_true]
  exact ⟨by decide +kernel, fz_all_190⟩

