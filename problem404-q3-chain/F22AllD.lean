import F22AllC

set_option exponentiation.threshold 1024
set_option maxHeartbeats 4000000
set_option maxRecDepth 262144

theorem fz_all_157 : List.all (dpRun fz_TAIL_157 fz_S_157) (fun S => decide (maxT S ≤ 253)) = true := by
  rw [fz_run_157, List.all_cons, Bool.and_eq_true]
  exact ⟨by decide +kernel, fz_all_158⟩

